votre-domaine.com {
	encode zstd gzip

	# L'API : tout ce qui commence par /api part vers le conteneur api,
	# sur le port interne 4000 (jamais exposé directement à l'extérieur).
	handle /api/* {
		reverse_proxy api:4010
	}

	# Le frontend (build statique de Vite). try_files retombe sur index.html
	# pour que les routes React Router (ex: /stock, /demandes) fonctionnent
	# même en accès direct ou après rafraîchissement de la page.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
