DATABASE_URL=postgresql://gugp:gugp@localhost:5433/gugp
JWT_SECRET=change-me-in-production
PORT=4010
CORS_ORIGIN=http://localhost:5173

# URL publique du frontend, utilisée dans le lien de connexion des e-mails
APP_URL=http://localhost:5173

# EMAIL — relais SMTP Brevo (https://app.brevo.com/settings/keys/smtp)
# SMTP_USER = l'adresse affichée comme "Login" sur cette page (souvent
# votre e-mail de compte Brevo, pas forcément SMTP_FROM).
# SMTP_PASS = la clé SMTP générée sur cette même page (pas votre mot de
# passe de compte Brevo).
# SMTP_FROM doit être une adresse expéditeur validée dans Brevo
# (Senders, Domains & Dedicated IPs → Senders).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=G-UGP <no-reply@ugp-boad.tg>
